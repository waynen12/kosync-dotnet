@* @page requires a literal - keep this in sync with AppRoutes.Dashboard *@
@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DeviceDashboardService DeviceDashboardService
@inject BookDashboardService BookDashboardService

<PageTitle>Dashboard</PageTitle>

<div class="ks-header">
    <h1 class="ks-title">Kosync Dashboard</h1>
    <p class="ks-subtitle">Your reading, across every device.</p>
    <div class="ks-tabs">
        <button type="button" class="ks-tab @(activeTab == Constants.DevicesTab ? "active" : "")" @onclick="() => activeTab = Constants.DevicesTab">Devices</button>
        <button type="button" class="ks-tab @(activeTab == Constants.BooksTab ? "active" : "")" @onclick="() => activeTab = Constants.BooksTab">Books</button>
    </div>
</div>

@if (activeTab == Constants.DevicesTab)
{
    <CardGrid Items="deviceCards" EmptyText="@Constants.NoDevicesSyncedText" />
}
else
{
    <CardGrid Items="bookCards" EmptyText="@Constants.NoBooksSyncedText" />
}

@code {
    // Deep-links the Books tab (e.g. AppRoutes.DashboardBooksTab) into its
    // initial server-rendered HTML instead of only reachable by clicking the
    // tab client-side - lets both users and tests land on it directly.
    [SupplyParameterFromQuery(Name = "tab")]
    [Parameter]
    public string? Tab { get; set; }

    private string activeTab = Constants.DevicesTab;
    private List<CardGridItem> deviceCards = new();
    private List<CardGridItem> bookCards = new();

    protected override async Task OnInitializedAsync()
    {
        activeTab = Tab == Constants.BooksTab ? Constants.BooksTab : Constants.DevicesTab;

        var devices = await DeviceDashboardService.GetDevicesAsync();
        deviceCards = devices.Select(device => new CardGridItem(
            Href: AppRoutes.DeviceDetail(device.Id),
            Title: device.DeviceName,
            ShowSplitFlagOnTitle: false,
            LastSyncedAt: device.LastSyncedAt,
            Sub: $"{DashboardFormatting.Pluralize(device.Documents.Count, "document")} synced",
            DocEmptyText: Constants.NoDeviceDocumentsSyncedText,
            DocRows: device.Documents
                .Select(doc => new CardGridDocRow(doc.DocumentHash, doc.Percentage, doc.IsSplitBook))
                .ToList()))
            .ToList();

        var books = await BookDashboardService.GetBooksAsync();
        bookCards = books.Select(book => new CardGridItem(
            Href: AppRoutes.BookDetail(book.Id),
            Title: $"Book #{book.Id}",
            ShowSplitFlagOnTitle: book.IsSplitBook,
            LastSyncedAt: book.LastSyncedAt,
            Sub: $"{DashboardFormatting.Pluralize(book.Documents.Count, "document")} · {DashboardFormatting.Percentage(book.Percentage)} progress",
            DocEmptyText: Constants.NoBookProgressText,
            DocRows: book.Documents
                .Select(doc => new CardGridDocRow(doc.DocumentHash, doc.Percentage, ShowSplitFlag: false))
                .ToList()))
            .ToList();
    }
}
