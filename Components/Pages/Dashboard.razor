@* @page requires a literal - keep this in sync with AppRoutes.Dashboard *@
@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@layout PrototypeEmptyLayout
@inject DeviceDashboardService DeviceDashboardService
@inject BookDashboardService BookDashboardService

@* PROTOTYPE (throwaway): ?variant=A|B|C swaps only the rendering. The data
   fetching below is the real thing, so every variant is judged against real
   devices, real books and real density. Drop the variant switch, the
   PrototypeSwitcher and the PrototypeEmptyLayout once a variant wins - see
   Components/Prototype/. *@

<PageTitle>Dashboard</PageTitle>

@if (Variant == PrototypeConstants.VariantB)
{
    <DashboardVariantB Devices="deviceItems" Books="bookItems" Tab="@activeTab" />
}
else if (Variant == PrototypeConstants.VariantC)
{
    <DashboardVariantC Devices="deviceItems" Books="bookItems" />
}
else
{
    <DashboardVariantA Devices="deviceItems" Books="bookItems" InitialTab="@activeTab" />
}

<PrototypeSwitcher Screen="@AppRoutes.Dashboard" Current="@Variant" />

@code {
    // Deep-links the Books tab (e.g. AppRoutes.DashboardBooksTab) into its
    // initial server-rendered HTML instead of only reachable by clicking the
    // tab client-side - lets both users and tests land on it directly.
    [SupplyParameterFromQuery(Name = "tab")]
    [Parameter]
    public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = PrototypeConstants.VariantQueryParam)]
    [Parameter]
    public string? VariantParam { get; set; }

    // PROTOTYPE: ?demo=1 appends synthetic rows in memory (no DB writes) so
    // the layouts can be judged at a plausible library size instead of the
    // two Devices and two Books actually stored. See PrototypeDemoData.
    [SupplyParameterFromQuery(Name = PrototypeDemoData.DemoQueryParam)]
    [Parameter]
    public string? DemoParam { get; set; }

    private string Variant => PrototypeConstants.Normalize(VariantParam);

    private string activeTab = Constants.DevicesTab;
    private List<PrototypeDashboardItem> deviceItems = new();
    private List<PrototypeDashboardItem> bookItems = new();

    protected override async Task OnInitializedAsync()
    {
        activeTab = Tab == Constants.BooksTab ? Constants.BooksTab : Constants.DevicesTab;

        var devices = await DeviceDashboardService.GetDevicesAsync();
        deviceItems = devices.Select(PrototypeDashboardItem.FromDevice).ToList();

        var books = await BookDashboardService.GetBooksAsync();
        bookItems = books.Select(PrototypeDashboardItem.FromBook).ToList();

        if (DemoParam == PrototypeDemoData.DemoOn)
        {
            deviceItems.AddRange(PrototypeDemoData.Devices());
            bookItems.AddRange(PrototypeDemoData.Books());
        }
    }
}
