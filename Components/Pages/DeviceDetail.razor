@* @page requires a literal - keep this in sync with AppRoutes.DeviceDetailTemplate *@
@page "/dashboard/devices/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PortalTenantResolver PortalTenant
@inject DeviceDashboardService DeviceDashboardService

<PageTitle>@(device?.DeviceName ?? "Device")</PageTitle>

<div class="ks-detail">
    <a class="ks-back" href="@AppRoutes.Dashboard">&larr; Back</a>

    @if (device is null)
    {
        <p class="ks-empty ks-empty-inline">@Constants.DeviceNotFoundText</p>
    }
    else
    {
        <h1 class="ks-detail-title">@device.DeviceName</h1>
        <p class="ks-detail-sub">Device ID @device.DeviceId &middot; last synced @DashboardFormatting.RelativeTime(device.LastSyncedAt, DateTime.UtcNow)</p>

        <div class="ks-section-title">Documents (@device.Documents.Count)</div>

        @if (device.Documents.Count == 0)
        {
            @* Issue #13's wording, and since #18 this is where it lives: the
               dashboard's table shows a Document count rather than listing
               Documents, so a Device's empty state is only ever here. *@
            <p class="ks-empty ks-empty-inline">@Constants.NoDeviceDocumentsSyncedText</p>
        }
        else
        {
            @foreach (var doc in device.Documents)
            {
                <div class="ks-doc-card">
                    @* Same pair as the Book detail page, for the same
                       reasons: a label to read, and the full hash to
                       diagnose a Split Book with (ADR 0007). *@
                    <span class="ks-doc-label">@doc.Label</span>
                    <span class="ks-doc-hash">@doc.DocumentHash</span>
                    <span class="ks-doc-pct">@DashboardFormatting.Percentage(doc.Percentage)</span>
                    @if (doc.IsSplitBook)
                    {
                        <span class="ks-flag-split">@Constants.SplitBookFlag</span>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private DeviceSummary? device;

    protected override async Task OnInitializedAsync()
    {
        // Scopes the query below to the signed-in User (ADR 0004). Another
        // User's Device id filters out and falls into the "Device not found"
        // path above.
        await PortalTenant.ScopeToSignedInUserAsync();

        device = await DeviceDashboardService.GetDeviceAsync(Id);
    }
}
