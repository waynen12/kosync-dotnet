@* THROWAWAY PROTOTYPE - Login variant C: "Zero round-trips".
   Same card, tokens and orange submit, but the gradient is reduced to a 3px
   rule along the card's top edge and the page sits on the plain background.
   Included because a full-screen gradient is a strong claim for a utility
   that people will open to check why a book didn't sync - worth seeing the
   quiet version next to A before committing. *@

<div class="hub-root hub-login hub-login-quiet">
    <div class="hub-login-card">
        <div class="hub-login-mark">
            <HubIcon Name="book-open" Size="15" />
            <span>@PrototypeConstants.BrandName</span>
        </div>

        <div class="hub-login-head">
            <h1 class="hub-login-title">@PrototypeConstants.LoginSubmitText</h1>
            <p class="hub-login-sub">@PrototypeConstants.BrandTagline</p>
        </div>

        @if (ShowError)
        {
            <div class="hub-login-error" role="alert">
                <HubIcon Name="alert" Size="15" />
                <span>@Constants.LoginErrorText</span>
            </div>
        }

        <EditForm Model="Input" FormName="login" OnSubmit="OnSubmit" method="post">
            <div class="hub-stack-4">
                <div class="hub-field">
                    <label class="hub-label" for="pt-username">@PrototypeConstants.LoginUsernameLabel</label>
                    <InputText id="pt-username" class="hub-input" @bind-Value="Input.Username"
                               placeholder="@PrototypeConstants.LoginUsernamePlaceholder" autocomplete="username" />
                </div>

                <div class="hub-field">
                    <label class="hub-label" for="pt-password">@PrototypeConstants.LoginPasswordLabel</label>
                    <InputText id="pt-password" type="password" class="hub-input" @bind-Value="Input.Password"
                               placeholder="@PrototypeConstants.LoginPasswordPlaceholder" autocomplete="current-password" />
                </div>

                <button type="submit" class="hub-btn hub-btn-brand hub-btn-lg hub-btn-block">
                    @PrototypeConstants.LoginSubmitText
                </button>
            </div>
        </EditForm>

        <p class="hub-login-hint">@PrototypeConstants.LoginSyncHint</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Login.LoginModel Input { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public bool ShowError { get; set; }
}
