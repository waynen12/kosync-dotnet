@* @page requires a literal - keep this in sync with AppRoutes.BookDetailTemplate *@
@page "/dashboard/books/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PortalTenantResolver PortalTenant
@inject BookDashboardService BookDashboardService

<PageTitle>@(book is null ? "Book" : book.Title)</PageTitle>

<div class="ks-detail">
    <a class="ks-back" href="@AppRoutes.DashboardBooksTab">&larr; Back</a>

    @if (book is null)
    {
        <p class="ks-empty ks-empty-inline">@Constants.BookNotFoundText</p>
    }
    else
    {
        @* Curated, then the most recent observation, then `Book #N` - all
           resolved in BookMetadataRule, never here (ADR 0007). *@
        <h1 class="ks-detail-title">
            @book.Title
            @if (book.IsSplitBook)
            {
                <span class="ks-flag-split">@Constants.SplitBookFlag</span>
            }
        </h1>
        @* The id stays on the page even once the Book has a title: it is
           what another Book gets merged into, and what KOReader's own
           screens cannot tell you. *@
        <p class="ks-detail-sub">
            @if (book.Author is not null)
            {
                <span>@book.Author</span>
                <span> &middot; </span>
            }
            <span>@string.Format(Constants.BookFallbackNameFormat, book.Id)</span>
            <span> &middot; </span>
            <span>@DashboardFormatting.Percentage(book.Percentage) progress</span>
            <span> &middot; </span>
            <span>last synced @DashboardFormatting.RelativeTime(book.LastSyncedAt, DateTime.UtcNow)</span>
        </p>

        <div class="ks-section-title">@Constants.CuratedMetadata.SectionTitle</div>
        <form class="ks-curate-form" @onsubmit="SaveCuratedAsync" @onsubmit:preventDefault="true">
            @* Bound to what was *curated*, not to what is displayed: an
               observation showing through must leave these blank, or saving
               would silently curate a device's guess. *@
            <input type="text"
                   class="ks-curate-input"
                   placeholder="@Constants.CuratedMetadata.TitlePlaceholder"
                   aria-label="@Constants.CuratedMetadata.TitleLabel"
                   @bind="curatedTitleInput" />
            <input type="text"
                   class="ks-curate-input"
                   placeholder="@Constants.CuratedMetadata.AuthorPlaceholder"
                   aria-label="@Constants.CuratedMetadata.AuthorLabel"
                   @bind="curatedAuthorInput" />
            <button type="submit" class="ks-merge-button">@Constants.CuratedMetadata.SaveButton</button>
            @if (book.CuratedTitle is not null || book.CuratedAuthor is not null)
            {
                <button type="button" class="ks-reset-button" @onclick="ClearCuratedAsync">@Constants.CuratedMetadata.ClearButton</button>
            }
        </form>
        <p class="ks-curate-hint">@Constants.CuratedMetadata.Hint</p>
        @if (curateError is not null)
        {
            <p class="ks-flag-regression ks-merge-error">@curateError</p>
        }

        <div class="ks-section-title">Merge another Book into this one</div>
        <form class="ks-merge-form" @onsubmit="MergeAsync" @onsubmit:preventDefault="true">
            <input type="number" min="1" class="ks-merge-input" placeholder="Book #" @bind="mergeBookIdInput" />
            <button type="submit" class="ks-merge-button">Merge</button>
        </form>
        @if (mergeError is not null)
        {
            <p class="ks-flag-regression ks-merge-error">@mergeError</p>
        }

        <div class="ks-section-title">Documents (@book.Documents.Count)</div>

        @if (book.Documents.Count == 0)
        {
            <p class="ks-empty ks-empty-inline">No sync history yet.</p>
        }
        else
        {
            @foreach (var doc in book.Documents)
            {
                <div class="ks-doc-card">
                    <span class="ks-doc-hash">@doc.DocumentHash</span>
                    @if (doc.HasCurrentProgress)
                    {
                        <span class="ks-card-meta">@doc.DeviceName</span>
                    }
                    <span class="ks-doc-pct">@DashboardFormatting.Percentage(doc.Percentage)</span>
                    <button type="button" class="ks-reset-button" @onclick="() => ResetProgressAsync(doc.DocumentId)">@Constants.ResetProgressButton</button>
                </div>
                @if (resetError is not null && resetErrorDocumentId == doc.DocumentId)
                {
                    <p class="ks-flag-regression ks-merge-error">@resetError</p>
                }

                <div class="ks-history">
                    @foreach (var syncEvent in doc.History)
                    {
                        <div class="ks-history-row">
                            @if (syncEvent.IsReset)
                            {
                                <span class="ks-card-meta">@Constants.ProgressResetLabel</span>
                                <span class="ks-card-meta">@DashboardFormatting.RelativeTime(syncEvent.Timestamp, DateTime.UtcNow)</span>
                                <span class="ks-flag-reset">@Constants.ProgressResetFlag</span>
                            }
                            else
                            {
                                <span class="ks-doc-pct">@DashboardFormatting.Percentage(syncEvent.Percentage)</span>
                                <span class="ks-card-meta">@syncEvent.DeviceName</span>
                                <span class="ks-card-meta">@DashboardFormatting.RelativeTime(syncEvent.Timestamp, DateTime.UtcNow)</span>
                                @if (!syncEvent.IsCurrent)
                                {
                                    <span class="ks-flag-regression">@Constants.ProgressRegressionFlag</span>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private BookSummary? book;
    private int? mergeBookIdInput;
    private string? mergeError;
    private string? resetError;
    private int? resetErrorDocumentId;
    private string? curatedTitleInput;
    private string? curatedAuthorInput;
    private string? curateError;

    protected override async Task OnInitializedAsync()
    {
        // Scopes every query below to the signed-in User (ADR 0004). It is
        // also this page's entire authorisation check: another User's Book id
        // filters out, GetBookAsync returns null, and the "Book not found"
        // path above already handles it.
        await PortalTenant.ScopeToSignedInUserAsync();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        book = await BookDashboardService.GetBookAsync(Id);

        curatedTitleInput = book?.CuratedTitle;
        curatedAuthorInput = book?.CuratedAuthor;
    }

    private async Task SaveCuratedAsync() =>
        await CurateAsync(curatedTitleInput, curatedAuthorInput);

    // Hands the action two blanks, which is how Curated Metadata is removed
    // (ADR 0007): the Book drops back to whatever its Documents observed.
    private async Task ClearCuratedAsync() => await CurateAsync(null, null);

    private async Task CurateAsync(string? title, string? author)
    {
        curateError = null;

        var result = await BookDashboardService.CurateBookAsync(Id, title, author);

        if (result == CurateBookResult.BookNotFound)
        {
            curateError = Constants.CuratedMetadata.SaveFailedError;
            return;
        }

        // Re-read rather than patching the summary in place: the title on
        // screen is a resolution over several tiers, and only the service
        // knows which one now wins.
        await LoadAsync();
    }

    private async Task ResetProgressAsync(int documentId)
    {
        resetError = null;
        resetErrorDocumentId = null;

        var result = await BookDashboardService.ResetProgressAsync(documentId);

        if (result == ResetProgressResult.DocumentNotFound)
        {
            resetError = Constants.ResetProgressFailedError;
            resetErrorDocumentId = documentId;
            return;
        }

        await LoadAsync();
    }

    private async Task MergeAsync()
    {
        mergeError = null;

        if (mergeBookIdInput is not int mergeBookId)
        {
            mergeError = Constants.MergeBookIdRequiredError;
            return;
        }

        var result = await BookDashboardService.MergeBooksAsync(Id, mergeBookId);

        mergeError = result switch
        {
            MergeBooksResult.Success => null,
            MergeBooksResult.SameBook => Constants.MergeSameBookError,
            MergeBooksResult.BookNotFound => string.Format(Constants.MergeBookNotFoundErrorFormat, mergeBookId),
            _ => Constants.MergeFailedError
        };

        if (result == MergeBooksResult.Success)
        {
            mergeBookIdInput = null;
            await LoadAsync();
        }
    }
}
