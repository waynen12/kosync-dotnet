@* @page requires a literal - keep this in sync with AppRoutes.Login *@
@page "/login"
@attribute [AllowAnonymous]
@layout PrototypeEmptyLayout
@inject KosyncDbContext Db
@inject NavigationManager Navigation
@inject IPService IPService
@inject PasswordHasher PasswordHasher
@inject ILogger<Login> Logger

@* PROTOTYPE (throwaway): ?variant=A|B|C swaps only the rendering. The form
   post, credential check and sign-in below are the real ones, so each
   variant can actually be logged in through. Remove the variant switch and
   the PrototypeSwitcher once a variant wins - see Components/Prototype/. *@

<PageTitle>Log in</PageTitle>

@if (Variant == PrototypeConstants.VariantB)
{
    <LoginVariantB Input="Input" OnSubmit="HandleLogin" ShowError="showError" />
}
else if (Variant == PrototypeConstants.VariantC)
{
    <LoginVariantC Input="Input" OnSubmit="HandleLogin" ShowError="showError" />
}
else
{
    <LoginVariantA Input="Input" OnSubmit="HandleLogin" ShowError="showError" />
}

<PrototypeSwitcher Screen="@AppRoutes.Login" Current="@Variant" />

@code {
    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = new();

    [SupplyParameterFromQuery(Name = PrototypeConstants.VariantQueryParam)]
    [Parameter]
    public string? VariantParam { get; set; }

    private string Variant => PrototypeConstants.Normalize(VariantParam);

    private bool showError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task HandleLogin()
    {
        var user = Db.Users.FirstOrDefault(u => u.Username == Input.Username);

        // The portal has plaintext, so it does the MD5 the sync client would
        // have done before verifying against the one stored credential
        // (ADR 0005).
        var passwordMatches = user is not null
            && PasswordHasher.VerifyPlainText(Input.Password ?? string.Empty, user.PasswordHash);

        if (user is null || !user.IsAdministrator || !user.IsActive || !passwordMatches)
        {
            Logger.LogWarning("[{ip}] Failed dashboard login attempt for [{username}].", IPService.ClientIP, Input.Username);
            showError = true;
            return;
        }

        var identity = new ClaimsIdentity(
            [new Claim(ClaimTypes.Name, user.Username)],
            CookieAuthenticationDefaults.AuthenticationScheme);

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity));

        Logger.LogInformation("[{ip}] User [{username}] logged into dashboard.", IPService.ClientIP, user.Username);

        Navigation.NavigateTo(AppRoutes.Dashboard, forceLoad: true);
    }

    // Public so the prototype login variants can bind to it. Revert to
    // private when the prototype is removed.
    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
