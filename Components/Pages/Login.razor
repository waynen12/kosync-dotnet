@* @page requires a literal - keep this in sync with AppRoutes.Login *@
@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout
@inject KosyncDbContext Db
@inject NavigationManager Navigation
@inject IPService IPService
@inject PasswordHasher PasswordHasher
@inject ILogger<Login> Logger

@* Static SSR, deliberately (ADR 0003): a plain form POST with no circuit.
   Nothing here may take a @rendermode - the sign-in below needs an
   HttpContext, which an interactive render does not have. *@

<PageTitle>@Constants.LoginPageTitle</PageTitle>

@* Deliberately not .hub-root: that is the nav-plus-main shell every other
   page wraps itself in, and .hub-login would have to re-declare half of it
   to override the background. *@
<div class="hub-login">
    <div class="hub-login-card">
        <div class="hub-login-head">
            <h1 class="hub-login-title">@Constants.BrandName</h1>
            <p class="hub-login-sub">@Constants.LoginHeading</p>
        </div>

        @* ai-hub raises a failed sign-in as a sonner toast, which needs a
           live client. This screen is Static SSR, so the error renders
           inline where the toast would have been. *@
        @if (showError)
        {
            <div class="hub-login-error" role="alert">
                <HubIcon Name="@Constants.Icons.Alert" Size="@Constants.Icons.InlineSize" />
                <span>@Constants.LoginErrorText</span>
            </div>
        }

        <EditForm Model="Input" FormName="login" OnSubmit="HandleLogin" method="post">
            <div class="hub-stack-4">
                <div class="hub-field">
                    <label class="hub-label" for="login-username">@Constants.LoginUsernameLabel</label>
                    <InputText id="login-username" class="hub-input" @bind-Value="Input.Username"
                               placeholder="@Constants.LoginUsernamePlaceholder" autocomplete="username" />
                </div>

                <div class="hub-field">
                    <label class="hub-label" for="login-password">@Constants.LoginPasswordLabel</label>
                    <InputText id="login-password" type="password" class="hub-input" @bind-Value="Input.Password"
                               placeholder="@Constants.LoginPasswordPlaceholder" autocomplete="current-password" />
                </div>

                <button type="submit" class="hub-btn hub-btn-brand hub-btn-lg hub-btn-block">
                    @Constants.LoginSubmitText
                </button>
            </div>
        </EditForm>

        <p class="hub-login-hint">@Constants.LoginSyncHint</p>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = new();

    private bool showError;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task HandleLogin()
    {
        var user = Db.Users.FirstOrDefault(u => u.Username == Input.Username);

        // The portal has plaintext, so it does the MD5 the sync client would
        // have done before verifying against the one stored credential
        // (ADR 0005).
        var passwordMatches = user is not null
            && PasswordHasher.VerifyPlainText(Input.Password ?? string.Empty, user.PasswordHash);

        if (user is null || !user.IsAdministrator || !user.IsActive || !passwordMatches)
        {
            Logger.LogWarning("[{ip}] Failed dashboard login attempt for [{username}].", IPService.ClientIP, Input.Username);
            showError = true;
            return;
        }

        var identity = new ClaimsIdentity(
            [new Claim(ClaimTypes.Name, user.Username)],
            CookieAuthenticationDefaults.AuthenticationScheme);

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity));

        Logger.LogInformation("[{ip}] User [{username}] logged into dashboard.", IPService.ClientIP, user.Username);

        Navigation.NavigateTo(AppRoutes.Dashboard, forceLoad: true);
    }

    private class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
