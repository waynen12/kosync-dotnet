@* @page requires a literal - keep this in sync with AppRoutes.ChangePassword *@
@page "/change-password"
@attribute [Authorize]
@layout LoginLayout
@inject KosyncDbContext Db
@inject NavigationManager Navigation
@inject IPService IPService
@inject PasswordHasher PasswordHasher
@inject PasswordPolicy PasswordPolicy
@inject ILogger<ChangePassword> Logger

@* Static SSR, for the same two reasons /login is (ADR 0003): the sign-in
   style form post needs an HttpContext, and - specific to this page - it is
   the one authenticated screen a gated User can reach, so it must not depend
   on a circuit the gate would never let them open. Nothing here may take a
   @@rendermode.

   It wears LoginLayout rather than MainLayout's app shell: the shell's nav
   links into a dashboard this User cannot reach yet, and the design calls
   for the same centred card /login uses (issue #24). *@

<PageTitle>@Constants.ChangePassword.PageTitle</PageTitle>

<div class="hub-login">
    <div class="hub-login-card">
        <div class="hub-login-head">
            <h1 class="hub-login-title">@Constants.ChangePassword.PageTitle</h1>
            <p class="hub-login-sub">@Constants.ChangePassword.Subheading</p>
        </div>

        @* Only for the User the gate sent here. Somebody changing a password
           they already chose knows why they are on this screen. *@
        @if (mustChangePassword)
        {
            <div class="hub-notice" role="status">
                <HubIcon Name="@Constants.Icons.KeyRound" Size="@Constants.Icons.InlineSize" />
                <span>@Constants.ChangePassword.RequiredNotice</span>
            </div>
        }

        @* Not optional, and not conditional either: the portal password and
           the sync password are the same stored credential (ADR 0005), so
           this is true of every password change, forced or not. ADR 0006
           named this warning as the mitigation it accepted that cost for. *@
        <div class="hub-notice" role="alert">
            <HubIcon Name="@Constants.Icons.Alert" Size="@Constants.Icons.InlineSize" />
            <span>@Constants.ChangePassword.DeviceInvalidationWarning</span>
        </div>

        @if (errorMessage is not null)
        {
            <div class="hub-login-error" role="alert">
                <HubIcon Name="@Constants.Icons.Alert" Size="@Constants.Icons.InlineSize" />
                <span>@errorMessage</span>
            </div>
        }

        <EditForm Model="Input" FormName="change-password" OnSubmit="HandleSubmit" method="post">
            <div class="hub-stack-4">
                <div class="hub-field">
                    <label class="hub-label" for="current-password">@Constants.ChangePassword.CurrentPasswordLabel</label>
                    <InputText id="current-password" type="password" class="hub-input" @bind-Value="Input!.CurrentPassword"
                               placeholder="@Constants.LoginPasswordPlaceholder" autocomplete="current-password" />
                </div>

                <div class="hub-field">
                    <label class="hub-label" for="new-password">@Constants.ChangePassword.NewPasswordLabel</label>
                    <InputText id="new-password" type="password" class="hub-input" @bind-Value="Input!.NewPassword"
                               placeholder="@Constants.LoginPasswordPlaceholder" autocomplete="new-password" />
                </div>

                <div class="hub-field">
                    <label class="hub-label" for="confirm-password">@Constants.ChangePassword.ConfirmPasswordLabel</label>
                    <InputText id="confirm-password" type="password" class="hub-input" @bind-Value="Input!.ConfirmPassword"
                               placeholder="@Constants.LoginPasswordPlaceholder" autocomplete="new-password" />
                </div>

                <button type="submit" class="hub-btn hub-btn-brand hub-btn-lg hub-btn-block">
                    @Constants.ChangePassword.SubmitText
                </button>
            </div>
        </EditForm>

        @* The other escape route the gate allows. A User who got here on
           somebody else's session - or who simply does not have the current
           password - would otherwise have nowhere to go. *@
        <p class="hub-login-hint">
            <a class="hub-login-link" href="@AppRoutes.Logout">@Constants.ChangePassword.SignOutLinkText</a>
        </p>
    </div>
</div>

@code {
    @* No property initializer: one on a [SupplyParameterFromForm] property
       is what raises BL0008 (issue #36). The form's model is restored from
       the post, so the only time this needs an instance of its own is the
       first GET. *@
    [SupplyParameterFromForm]
    private ChangePasswordModel? Input { get; set; }

    private string? errorMessage;

    private bool mustChangePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new ChangePasswordModel();

        // Which of the two notices the page opens with. Read from the User
        // rather than from "did the gate send me here", because a redirect
        // leaves no trace on the request it lands on.
        mustChangePassword = SignedInUser()?.MustChangePassword ?? false;
    }

    private void HandleSubmit()
    {
        var user = SignedInUser();

        if (user is null)
        {
            // The cookie names a User who no longer exists. Nothing to change
            // and nothing to say about it - sign-out is the only sensible
            // destination.
            Navigation.NavigateTo(AppRoutes.Logout, forceLoad: true);
            return;
        }

        var input = Input ?? new ChangePasswordModel();

        // Checked before anything else and said the same way the login error
        // is: holding a session is not proof that the person at the keyboard
        // knows the password, and this is the request that changes it.
        if (!PasswordHasher.VerifyPlainText(input.CurrentPassword ?? string.Empty, user.PasswordHash))
        {
            Logger.LogWarning(
                "[{ip}] Password change for [{username}] refused: current password did not match.",
                IPService.ClientIP, user.Username);

            errorMessage = Constants.ChangePassword.CurrentPasswordWrongError;
            return;
        }

        // Every rule about the password itself, including "not the one you
        // already have" - the page knows the current password here, so it
        // can be checked rather than inferred.
        errorMessage = PasswordPolicy.Validate(input.NewPassword, input.CurrentPassword);

        if (errorMessage is not null)
        {
            return;
        }

        // Not a policy rule: a confirmation field is this form's device for
        // catching a typo, and nothing outside a form has one.
        if (input.NewPassword != input.ConfirmPassword)
        {
            errorMessage = Constants.ChangePassword.ConfirmationMismatchError;
            return;
        }

        user.PasswordHash = PasswordHasher.HashPlainText(input.NewPassword!);
        user.PasswordState = PasswordState.UserChosen;
        Db.SaveChanges();

        Logger.LogInformation(
            "[{ip}] User [{username}] changed their own password in the portal.",
            IPService.ClientIP, user.Username);

        // The cookie carries only the username, so the session outlives the
        // credential it was issued against and needs no refresh. The gate
        // reads the new state on the very next request.
        Navigation.NavigateTo(AppRoutes.Dashboard, forceLoad: true);
    }

    // Users carry no tenant filter (ADR 0004), so this read needs no scoping
    // step - which is just as well, since a gated User has no library view
    // to scope to yet.
    private User? SignedInUser()
    {
        var username = HttpContext.User.Identity?.Name;

        return string.IsNullOrEmpty(username)
            ? null
            : Db.Users.FirstOrDefault(u => u.Username == username);
    }

    private class ChangePasswordModel
    {
        public string? CurrentPassword { get; set; }

        public string? NewPassword { get; set; }

        public string? ConfirmPassword { get; set; }
    }
}
