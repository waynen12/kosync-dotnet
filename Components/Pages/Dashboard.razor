@* @page requires a literal - keep this in sync with AppRoutes.Dashboard *@
@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PortalTenantResolver PortalTenant
@inject DeviceDashboardService DeviceDashboardService
@inject BookDashboardService BookDashboardService

@* The hub's "admin console" shape: a sidebar beside a dense table of either
   Devices or Books, folded in from the prototype's winning variant with
   issue #18. Why a table rather than the card grid it replaced is
   docs/ROADMAP.md's business ("Why the card grid lost, for both lists") -
   in short, these lists are scanned for the one thing that went wrong, and
   a table aligns every progress bar and every flag into one column.

   The table shows a Document *count* where the card grid listed a hash row
   per Document. Also deliberate, also in the ROADMAP ("The dashboard stops
   listing documents"): Documents live on the drill-in now. *@

<PageTitle>@Constants.Dashboard.PageTitle</PageTitle>

<div class="hub-shell">
    @* Plain <a href>, deliberately. The section on screen is this page's
       `tab` query parameter, so switching it is a navigation the browser
       performs - no circuit message, no component state, and a back button
       that goes back (ADR 0003, "local UI state must not round-trip").

       The prototype's Administration group now has a real destination
       (issue #28) and is below, as UsersNavGroup - which renders nothing at
       all for a User without the capability, so the sidebar still has no
       dead chrome in it. *@
    <nav class="hub-sidebar">
        <p class="hub-sidebar-group hub-section-label">@Constants.Dashboard.NavGroupLibrary</p>

        <a class="@NavItemClass(!IsBooks)" href="@AppRoutes.Dashboard" aria-current="@AriaCurrent(!IsBooks)">
            <HubIcon Name="@Constants.Icons.Device" Size="@Constants.Icons.SidebarSize" />
            <span>@Constants.Dashboard.DevicesLabel</span>
            @* No count on an empty library, rather than a 0 reading as a
               fault. The empty state says it in words instead. *@
            @if (deviceRows.Count > 0)
            {
                <span class="hub-nav-count">@deviceRows.Count</span>
            }
        </a>

        <a class="@NavItemClass(IsBooks)" href="@AppRoutes.DashboardBooksTab" aria-current="@AriaCurrent(IsBooks)">
            <HubIcon Name="@Constants.Icons.BookOpen" Size="@Constants.Icons.SidebarSize" />
            <span>@Constants.Dashboard.BooksLabel</span>
            @if (bookRows.Count > 0)
            {
                <span class="hub-nav-count">@bookRows.Count</span>
            }
        </a>

        <UsersNavGroup />
    </nav>

    <main class="hub-shell-main">
        <div class="hub-page-head">
            <h1 class="hub-page-title">@SectionLabel</h1>
            <p class="hub-page-sub">@Constants.BrandTagline</p>
        </div>

        @if (Rows.Count == 0)
        {
            <p class="hub-empty">@(IsBooks ? Constants.NoBooksSyncedText : Constants.NoDevicesSyncedText)</p>
        }
        else
        {
            <div class="hub-toolbar">
                <span class="hub-sm hub-muted">
                    @DashboardFormatting.Pluralize(Rows.Count, SectionNoun)
                    @if (FlaggedCount > 0)
                    {
                        <span> · </span>
                        <span class="hub-flagged-count">@FlaggedText</span>
                    }
                </span>

                @* A plain input, no @@oninput: typing filters rows that are
                   already in the page, which ADR 0003's amendment puts on the
                   client. wwwroot/js/dashboard-filter.js is the whole of it. *@
                <input class="hub-input hub-input-sm hub-toolbar-search"
                       type="search"
                       placeholder="@Constants.Dashboard.SearchPlaceholder"
                       aria-label="@Constants.Dashboard.SearchPlaceholder"
                       data-ks-filter="#@Constants.Dashboard.TableId" />
            </div>

            <div class="hub-table-wrap" id="@Constants.Dashboard.TableId">
                <table class="hub-table">
                    <thead>
                        <tr>
                            <th>@Constants.Dashboard.ColumnName</th>
                            <th class="hub-table-num">@Constants.Dashboard.ColumnDocuments</th>
                            <th>@Constants.Dashboard.ColumnProgress</th>
                            <th>@Constants.Dashboard.ColumnLastSynced</th>
                            <th>@Constants.Dashboard.ColumnFlags</th>
                            @* Blank on screen - one button per row needs no
                               label over it - but not blank to a screen
                               reader, which otherwise meets an unnamed
                               column. *@
                            <th class="hub-table-actions"><span class="hub-sr-only">@Constants.Dashboard.ColumnActions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows)
                        {
                            @* data-ks-text is what the toolbar filter matches
                               this row against - including its Document
                               hashes, which have no column of their own. See
                               DashboardRow.SearchText. *@
                            <tr data-ks-text="@row.SearchText">
                                @* The name is a link, and so is the action in
                                   the last cell, rather than the whole <tr>
                                   being the click target: a row-level click
                                   needs script, and the prototype wrote it as
                                   an @@onclick - bouncing a navigation off the
                                   server for a destination the markup already
                                   carries (ADR 0003). *@
                                <td class="hub-table-name">
                                    <a class="hub-table-link" href="@row.Href">
                                        <HubIcon Name="@row.Icon" Size="@Constants.Icons.InlineSize" Class="hub-muted" />
                                        @row.Name
                                    </a>
                                </td>
                                <td class="hub-table-num">@row.DocumentCount</td>
                                <td>
                                    <span class="hub-table-progress">
                                        <span class="hub-bar"><span style="width: @row.ProgressText"></span></span>
                                        <span class="hub-pct">@row.ProgressText</span>
                                    </span>
                                </td>
                                <td class="hub-muted hub-xs">@row.RelativeTime</td>
                                <td>
                                    @if (row.IsFlagged)
                                    {
                                        <span class="hub-badge hub-badge-warn">
                                            <HubIcon Name="@Constants.Icons.Merge" Size="@Constants.Icons.BadgeSize" />
                                            @Constants.SplitBookFlag
                                        </span>
                                    }
                                    @* A Book can carry both: being split is
                                       about progress disagreeing, having a
                                       suggestion is about another Book
                                       reporting the same title (ADR 0007).
                                       Outline rather than warn, because
                                       nothing has gone wrong here - there is
                                       a choice waiting on the drill-in. *@
                                    @if (row.HasMergeSuggestion)
                                    {
                                        <span class="hub-badge hub-badge-outline">
                                            <HubIcon Name="@Constants.Icons.Library" Size="@Constants.Icons.BadgeSize" />
                                            @Constants.MergeSuggestions.Flag
                                        </span>
                                    }
                                    @if (row.HasNoFlags)
                                    {
                                        <span class="hub-muted hub-xs">@Constants.Dashboard.NoFlagsText</span>
                                    }
                                </td>
                                <td class="hub-table-actions">
                                    <a class="hub-btn hub-btn-outline hub-btn-sm" href="@row.Href">
                                        @Constants.Dashboard.OpenAction
                                        <HubIcon Name="@Constants.Icons.ChevronRight" Size="@Constants.Icons.BadgeSize" />
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* Hidden until the filter sets [data-none] on the wrap above,
                   so an empty result reads as an empty result rather than as
                   an empty library - which has its own, different message. *@
                <p class="hub-list-none">@Constants.Dashboard.NoMatchesText</p>
            </div>
        }
    </main>
</div>

@code {
    // Deep-links the Books section (e.g. AppRoutes.DashboardBooksTab) into its
    // initial server-rendered HTML. Since issue #18 this is the only way the
    // section changes at all - the sidebar links here rather than flipping a
    // field, so this parameter *is* the section, not merely a shortcut to it.
    [SupplyParameterFromQuery(Name = "tab")]
    [Parameter]
    public string? Tab { get; set; }

    private bool IsBooks => Tab == Constants.BooksTab;

    private string SectionLabel =>
        IsBooks ? Constants.Dashboard.BooksLabel : Constants.Dashboard.DevicesLabel;

    // The heading's label is a section name ("Books"); the toolbar counts
    // things ("2 books"), so it needs the singular to pluralise from.
    private string SectionNoun =>
        IsBooks ? Constants.Dashboard.BookNoun : Constants.Dashboard.DeviceNoun;

    private int FlaggedCount => Rows.Count(row => row.IsFlagged);

    // A flagged Book is a Split Book; a flagged Device merely holds a
    // Document belonging to one, so the two cannot be counted in the same
    // words without the Devices section saying something untrue.
    private string FlaggedText => IsBooks
        ? DashboardFormatting.Pluralize(FlaggedCount, Constants.Dashboard.FlaggedBooksNoun)
        : string.Format(
            Constants.Dashboard.FlaggedDevicesFormat,
            DashboardFormatting.Pluralize(FlaggedCount, Constants.Dashboard.DeviceNoun));

    // Built here rather than inline, so the section not on screen renders
    // `class="hub-nav-item"` instead of a trailing-space `"hub-nav-item "`.
    private static string NavItemClass(bool current) =>
        current ? "hub-nav-item current" : "hub-nav-item";

    // The same fact as the `current` class, for a reader that cannot see a
    // background colour. Null renders no attribute at all, which is what
    // "not the current page" has to be - aria-current="false" is a value.
    private static string? AriaCurrent(bool current) => current ? "page" : null;

    private List<DashboardRow> deviceRows = new();
    private List<DashboardRow> bookRows = new();

    private List<DashboardRow> Rows => IsBooks ? bookRows : deviceRows;

    // Both sections are loaded, not only the one on screen, because the
    // sidebar labels each with its size - and a count the other section's
    // query would have to supply is worse as a blank or a 0 than it is as one
    // extra read. The same two calls the card grid made.
    protected override async Task OnInitializedAsync()
    {
        // Scopes every query below to the signed-in User (ADR 0004). Must come
        // first: without it the filters match nothing and the page renders its
        // empty state.
        await PortalTenant.ScopeToSignedInUserAsync();

        deviceRows = (await DeviceDashboardService.GetDevicesAsync()).Select(DashboardRow.FromDevice).ToList();
        bookRows = (await BookDashboardService.GetBooksAsync()).Select(DashboardRow.FromBook).ToList();
    }
}
